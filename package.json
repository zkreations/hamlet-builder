{
  "name": "hamlet-builder",
  "type": "module",
  "version": "1.8.0",
  "description": "Compiler used by the Hamlet theme for Blogger developers.",
  "author": "zkreations <daniel@zkreations.com> (https://zkreations.com/)",
  "license": "MIT",
  "homepage": "https://github.com/zkreations/hamlet-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkreations/hamlet-builder.git"
  },
  "bugs": {
    "url": "https://github.com/zkreations/hamlet-builder/issues"
  },
  "keywords": [
    "blogger",
    "compiler",
    "handlebars",
    "theme",
    "builder",
    "blogger-template",
    "rollup",
    "postcss",
    "lightningcss"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "bin": {
    "hamlet": "bin.js",
    "hamlet-builder": "bin.js"
  },
  "files": [
    "bin.js",
    "lib"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:partials": "node ./scripts/build-partials.js",
    "prepublishOnly": "npm run build:partials"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.9",
    "lightningcss": "^1.33.0",
    "lilconfig": "^3.1.3",
    "postcss": "^8.5.26",
    "rollup": "^4.63.1",
    "sass": "^1.103.1",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "eslint": "^10.9.1",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    ">= 1%",
    "last 2 major versions",
    "not dead",
    "not edge <= 18",
    "not ie <= 11"
  ]
}
